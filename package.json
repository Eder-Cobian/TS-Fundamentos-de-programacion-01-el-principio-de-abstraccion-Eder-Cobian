{
  "name": "javascript-playbook",
  "version": "1.0.0",
  "description": "Javascript Learning Challenges",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "test": "jest",
    "lint": "eslint \"./src/**/*.{ts,tsx,js}\"",
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  },
  "author": "Carlos Flores",
  "license": "CC BY-NC-SA 4.0",
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/node": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "eslint": "^8.18.0",
    "eslint-config-google": "^0.14.0",
    "husky": "^8.0.1",
    "jest": "^29.7.0",
    "lint-staged": "^13.3.0",
    "readline-sync": "^1.4.10"
  },
  "dependencies": {
    "@types/readline-sync": "^1.4.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "npm run lint"
    ]
  }
