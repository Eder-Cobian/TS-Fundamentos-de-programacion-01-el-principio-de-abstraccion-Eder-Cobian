{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended", "google"],

  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "require-jsdoc": 0,
    "eol-last": 0,
    "max-len": 0,
    "linebreak-style": 0,
    "camelcase": [2, { "properties": "always" }]
  }
}
